# ==============================================================================
# KTU Notes Hub — Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your Supabase project credentials.
# IMPORTANT:
# - Use ONLY the public Anon key on the frontend (VITE_SUPABASE_ANON_KEY).
# - NEVER commit your service role secret key or real credentials to Git!
# ==============================================================================

# Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
