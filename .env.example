# ==============================================================================
# KTU Notes Hub — Environment Configuration Template
# ==============================================================================
# Copy this file to a new file named '.env' in the project root directory.
#
# IMPORTANT SECURITY RULES:
# - Use ONLY the public client / publishable key on the frontend.
# - NEVER paste or commit your service role secret key to Git!
# ==============================================================================

# Your Supabase Project URL (e.g. https://ncnivplskuoqcvlgsewj.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Modern Supabase Publishable API Key (found in Project Settings -> API)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
